# ---------- Server (apps/server) ----------
PORT=4000
# Kosongkan untuk memakai PGlite (Postgres in-process, data di ./.data/pglite)
DATABASE_URL=postgres://aioffice:aioffice@localhost:5432/aioffice
# Kosongkan untuk mode mock (tanpa LLM, agent memakai skrip)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Origin web yang diizinkan membuka WebSocket
WEB_ORIGIN=http://localhost:3000
# Kecepatan simulasi orkestrator
TICK_MS=1500
MOCK_PROGRESS_STEP=12
SESSION_TTL_HOURS=12

# ---------- Web (apps/web) ----------
API_URL=http://localhost:4000
# Isi bila WebSocket server berada di host lain, mis. wss://api.contoh.id
NEXT_PUBLIC_WS_BASE=
